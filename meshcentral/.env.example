# Copy to .env and set HOSTNAME to the public DNS name used by the server and agents.
HOSTNAME=meshcentral.example.com
MESH_BRAND_NAME=Your Organization

# The upstream MeshCentral version used as the base image.
MESHCENTRAL_VERSION=1.2.6
IMAGE_TAG=1.2.6

# Host ports; change them if 80 or 443 are already in use.
HTTP_PORT=80
HTTPS_PORT=443

# First user can register during initial setup; later signups are disabled by default.
ALLOW_NEW_ACCOUNTS=false
TZ=UTC
